{
  "id": "extender:dark-map",
  "name": "Dark Map",
  "description": "Applies a dark filter to the map tiles only, leaving your markers and overlays in their original colours.",
  "version": "1.0.0",
  "author": "Map Extender",
  "usage": "Always-on map filter",
  "matchPatterns": [
    "*://*/*"
  ],
  "settingsSchema": [
    {
      "key": "brightness",
      "label": "Brightness (0.3–1.5)",
      "type": "number",
      "default": 0.9
    },
    {
      "key": "contrast",
      "label": "Contrast (0.5–2)",
      "type": "number",
      "default": 1.05
    }
  ],
  "settings": {
    "brightness": 0.9,
    "contrast": 1.05
  },
  "screenshots": []
}
